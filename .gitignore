# dependencies
node_modules/
**/node_modules/

# secrets & env (NEVER commit)
.env
.env.local
.env*.local
.mcp.json
**/.env
**/.env.local

# expo / metro
.expo/
**/.expo/
dist/
web-build/
*.tsbuildinfo

# native build output (generated)
**/ios/
**/android/

# vercel
.vercel

# agent / editor local config
.claude/
**/.claude/

# generated data intermediates (rebuilt by scripts/build-quran.mjs)
scripts/data/

# QA battery output (regenerate with: node scripts/test-chat.mjs)
scripts/test-results.json

# throwaway smoke-test photos for scripts/test-see.mjs (download via that flow; not source)
scripts/test-images/

# Story-art originals (large; regenerate with scripts/gen-story-art.mjs, then
# scripts/bundle-story-art.mjs writes the lean committed copies into mobile/assets)
content/stories/yusuf-art/

# misc
.DS_Store
*.log
npm-debug.*
yarn-error.*
coverage/

.vercel
