# dependencies
node_modules/
**/node_modules/

# secrets & env (NEVER commit)
.env
.env.local
.env*.local
.mcp.json
**/.env
**/.env.local

# expo / metro
.expo/
**/.expo/
dist/
web-build/
*.tsbuildinfo

# native build output (generated)
**/ios/
**/android/

# vercel
.vercel

# agent / editor local config
.claude/
**/.claude/

# generated data intermediates (rebuilt by scripts/build-quran.mjs)
scripts/data/

# QA battery output (regenerate with: node scripts/test-chat.mjs)
scripts/test-results.json

# throwaway smoke-test photos for scripts/test-see.mjs (download via that flow; not source)
scripts/test-images/

# Story-art originals + montage contact-sheets (large; regenerate with
# scripts/gen-stories-art.mjs, then scripts/bundle-stories-art.mjs writes the lean
# committed copies into mobile/assets). Covers yusuf-art + all 9 new <id>-art dirs.
content/stories/*-art/
content/stories/_montage-*.png

# throwaway underscore-prefixed one-off scripts + smoke images
scripts/_*

# user-provided design source folder (left untracked on purpose)
vecteezy_*/

# misc
.DS_Store
*.log
npm-debug.*
yarn-error.*
coverage/

.vercel

# UI redesign reference screenshots (local design aids; large + third-party, not source)
Bible-chat/
Ui-Design/

# agentic-log submission artifact (the committed .claude-logs/ folder is the source of truth)
claude-logs.zip
