# ─── Qur'an Chat App — environment template ───
# Copy to .env (gitignored) and fill in. NEVER commit real values.

# Supabase (client-safe; protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only (seeding / admin) — NEVER expose to the app
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers — server-side only (Vercel env vars), never in the app bundle
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Embeddings (BGE-M3 via HF Inference, or batch via Colab)
HUGGINGFACE_API_TOKEN=
