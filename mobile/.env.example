# ---------------------------------------------------------------------------
# Public client config. To run the app, just copy this file to .env:
#     cp .env.example .env
#
# These are Expo EXPO_PUBLIC_* variables — they are embedded in the app's JS
# bundle by design and are NOT secrets. The Supabase anon key is public and
# RLS-protected; the API base is a public URL. The only real secret (the Groq
# API key) lives SERVER-SIDE on Vercel — the app never sees it.
# After editing, restart Expo with:  npx expo start -c
# ---------------------------------------------------------------------------

# Deployed backend API (Vercel) — powers AI chat, voice, and photo reflection.
EXPO_PUBLIC_API_BASE=https://daily-quran-murex.vercel.app

# Supabase — accounts + the community "Ameen" wall. Anon key is public + RLS-protected.
EXPO_PUBLIC_SUPABASE_URL=https://fznzuypkmdbnwzatukbi.supabase.co
